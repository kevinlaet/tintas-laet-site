# Sistema operacional
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/

# Claude Code (sessões locais, não devem ir pro repo)
.claude/projects/
.claude/sessions/
.claude/shell-snapshots/
.claude/telemetry/
.claude/file-history/
.claude/backups/

# Dependências
node_modules/

# Segredos
.env

# Arquivos temporários
*.log
*.tmp

# Drop zone do usuário (só o README vai versionado)
dados/*
!dados/README.md

# Memória interna (estratégia, financeiro, método) — privado, não pode ir pro repo público
_memoria/

# Cores: saída intermediária das ferramentas de extração (só o mestre em identidade/cores vale)
scripts/cores/extracao/saida-*.json

# Catálogos em PDF gerados por scripts/catalogos-pdf/gerar.js (regeráveis, pesados)
saidas/catalogos-pdf/
